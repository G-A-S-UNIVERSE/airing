# AiRing - Environment Variables Template
# Copy this file to `.env` and fill in your own values.
# DO NOT commit `.env` to git (already in .gitignore).

# ============================================================
# Database
# ============================================================
# SQLite (default, no setup):
DATABASE_URL=sqlite+aiosqlite:///./airing.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://airing:airing@localhost:5432/airing

# ============================================================
# Cache
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Security
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-random-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# OLT Vendors (set only what you use)
# ============================================================
# PATIH CLI API (your local PATIH OLT manager)
PATIH_MQTT_HOST=localhost
PATIH_MQTT_PORT=1883
PATIH_CLI_API=http://localhost:8080/execute

# CMS C-DATA (if used)
CMS_API_HOST=localhost
CMS_API_PORT=9999
CMS_API_TOKEN=changeme
CMS_API_BASE_URL=http://localhost/v1/openapi/cms

# SmartOLT (SaaS)
SMARTOLT_API_KEY=changeme
SMARTOLT_API_URL=https://api.smartolt.com

# ============================================================
# SNMP (for ZTE/Huawei/FiberHome OLTs)
# ============================================================
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT=5
SNMP_RETRIES=3
SNMP_POLL_INTERVAL=60

# ============================================================
# Telemetry integrations (optional)
# ============================================================
# Zabbix (webhook source)
ZABBIX_WEBHOOK_SECRET=changeme-shared-with-zabbix

# LibreNMS (read-only sensor data)
LIBRENMS_API_TOKEN=changeme
LIBRENMS_BASE_URL=https://nms.example.com

# Observium (legacy, LibreNMS recommended)
OBSERVIUM_BASE_URL=https://obsv.example.com
OBSERVIUM_USERNAME=admin
OBSERVIUM_PASSWORD=changeme

# ============================================================
# Telegram (for alert dispatch)
# ============================================================
TELEGRAM_BOT_TOKEN=changeme-from-botfather
TELEGRAM_CHAT_ID_ALERT=0
TELEGRAM_CHAT_ID_OPS=0

# ============================================================
# LLM gateway (for AI-assisted triage)
# ============================================================
OMNIROUTE_API_URL=http://localhost:4000/v1/chat/completions
OMNIROUTE_API_KEY=changeme

# ============================================================
# App config
# ============================================================
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
APP_ENV=development
