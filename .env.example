# AiRing — environment template.
# Copy to .env, fill in real values, and NEVER commit .env.
#
# The values below are Star Wars / Star Trek placeholders so this file
# is safe to commit. They will NOT grant access to any real OLT.

APP_ENV=development
APP_NAME=AiRing
APP_VERSION=0.1.0

# Production requires a real value — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-random-32-bytes

# --- Database / cache ---
DATABASE_URL=sqlite+aiosqlite:///./airing.db
REDIS_URL=redis://localhost:6379/0

# --- ZTE OLT (Star Wars) ---
ZTE_DEFAULT_HOST=10.42.0.11
ZTE_DEFAULT_PORT=23
ZTE_PROMPT_MARKER=ZXAN
TELNET_USERNAME=force_ghost
TELNET_PASSWORD=may_the_force_be_with_you

# --- C-Data OLT (Star Trek) ---
CDATA_DEFAULT_HOST=10.43.0.21
CDATA_DEFAULT_PORT=23
CDATA_PROMPT_MARKER=epon
CDATA_USERNAME=picard
CDATA_PASSWORD=make_it_so_1701

# --- PATIH bridge ---
PATIH_MQTT_HOST=localhost
PATIH_MQTT_PORT=1883
PATIH_CLI_API=http://localhost:8080/execute

# --- CMS / SmartOLT ---
CMS_API_HOST=localhost
CMS_API_PORT=9999
CMS_API_TOKEN=changeme
CMS_API_BASE_URL=http://localhost/v1/openapi/cms
SMARTOLT_API_KEY=changeme
SMARTOLT_API_URL=https://api.smartolt.com

# --- SNMP ---
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT=5
SNMP_RETRIES=3
SNMP_POLL_INTERVAL=60

# --- Logging / CORS ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
